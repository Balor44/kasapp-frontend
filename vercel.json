{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://kasapp2-production.up.railway.app/api/$1"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "https://kasapp2-production.up.railway.app/webhooks/$1"
    },
    {
      "source": "/((?!api/|webhooks/).*)",
      "destination": "/index.html"
    }
  ]
}


